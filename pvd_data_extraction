def save_radial_profiles(region_name, t_idx, time_val, axes, center):
    x_axis, y_axis, z_axis = axes
    slice_B = Slice(Input=calculator_B)
    slice_B.SliceType = 'Plane'
    slice_B.SliceType.Origin = center
    slice_B.SliceType.Normal = z_axis.tolist()
    slice_B.Triangulatetheslice = 0
    slice_B.UpdatePipeline()
    data = servermanager.Fetch(slice_B)
    points = data.GetPoints()
    b_array = data.GetPointData().GetArray('B')
    if b_array is None:
        Delete(slice_B)
        gc.collect()
        return None, None, None, None, None, None
    radii = []
    bz_vals = []
    bphi_vals = []
    br_vals = []
    bmag_vals = []
    for i in range(points.GetNumberOfPoints()):
        px, py, pz = points.GetPoint(i)
        bx, by, bz = b_array.GetTuple(i)
        r, phi, _, _ = point_cylindrical_coords(px, py, pz, center, z_axis, x_axis, y_axis)
        br, bphi, bz_comp = point_vector_decomposition(px, py, pz, bx, by, bz, center, z_axis, x_axis, y_axis)
        radii.append(r)
        br_vals.append(br)
        bphi_vals.append(bphi)
        bz_vals.append(bz_comp)
        bmag_vals.append(np.sqrt(bx * bx + by * by + bz * bz))
    if not radii:
        Delete(slice_B)
        gc.collect()
        return None, None, None, None, None, None
    radii = np.array(radii)
    bz_vals = np.array(bz_vals)
    bphi_vals = np.array(bphi_vals)
    br_vals = np.array(br_vals)
    bmag_vals = np.array(bmag_vals)
    sort_idx = np.argsort(radii)
    radii = radii[sort_idx]
    bz_vals = bz_vals[sort_idx]
    bphi_vals = bphi_vals[sort_idx]
    br_vals = br_vals[sort_idx]
    bmag_vals = bmag_vals[sort_idx]
    r_max = np.percentile(radii, 95)
    r_max = max(r_max, 0.02)
    r_bins = np.linspace(0, r_max, N_BINS + 1)
    bin_centers = (r_bins[:-1] + r_bins[1:]) / 2
    bz_mean = np.zeros(N_BINS)
    bz_std = np.zeros(N_BINS)
    bphi_mean = np.zeros(N_BINS)
    bphi_std = np.zeros(N_BINS)
    br_mean = np.zeros(N_BINS)
    br_std = np.zeros(N_BINS)
    bmag_mean = np.zeros(N_BINS)
    bmag_std = np.zeros(N_BINS)
    n_per_bin = np.zeros(N_BINS)
    for i in range(N_BINS):
        mask = (radii >= r_bins[i]) & (radii < r_bins[i + 1])
        n_in_bin = np.sum(mask)
        if n_in_bin > 0:
            n_per_bin[i] = n_in_bin
            bz_mean[i] = np.mean(bz_vals[mask])
            bz_std[i] = np.std(bz_vals[mask])
            bphi_mean[i] = np.mean(bphi_vals[mask])
            bphi_std[i] = np.std(bphi_vals[mask])
            br_mean[i] = np.mean(br_vals[mask])
            br_std[i] = np.std(br_vals[mask])
            bmag_mean[i] = np.mean(bmag_vals[mask])
            bmag_std[i] = np.std(bmag_vals[mask])
    region_dir = os.path.join(OUTPUT_BASE, region_name)
    os.makedirs(os.path.join(region_dir, 'profiles'), exist_ok=True)
    b_profile_file = os.path.join(region_dir, 'profiles', f'B_profile_t{t_idx:04d}.txt')
    with open(b_profile_file, 'w') as f:
        f.write(f"# Time: {time_val}\n")
        f.write("# r,Bz_mean,Bz_std,Bphi_mean,Bphi_std,Br_mean,Br_std,Bmag_mean,Bmag_std,n_points\n")
        for i in range(N_BINS):
            if n_per_bin[i] > 0:
                f.write(f"{bin_centers[i]:.6f},{bz_mean[i]:.6f},{bz_std[i]:.6f},"
                        f"{bphi_mean[i]:.6f},{bphi_std[i]:.6f},{br_mean[i]:.6f},{br_std[i]:.6f},"
                        f"{bmag_mean[i]:.6f},{bmag_std[i]:.6f},{int(n_per_bin[i])}\n")
    Delete(slice_B)
    gc.collect()
    return bin_centers, bz_mean, bphi_mean, bmag_mean, br_mean, n_per_bin

def save_twist(region_name, t_idx, radii, bphi_mean, bz_mean, n_per_bin):
    valid = (n_per_bin > 0) & (radii > 0.01) & (np.abs(bz_mean) > 1e-6)
    if not np.any(valid):
        return
    radii_valid = radii[valid]
    bphi_valid = bphi_mean[valid]
    bz_valid = bz_mean[valid]
    twist = bphi_valid / (radii_valid * bz_valid)
    region_dir = os.path.join(OUTPUT_BASE, region_name)
    os.makedirs(os.path.join(region_dir, 'twist'), exist_ok=True)
    twist_file = os.path.join(region_dir, 'twist', f'twist_t{t_idx:04d}.txt')
    with open(twist_file, 'w') as f:
        f.write("r,twist\n")
        for i in range(len(radii_valid)):
            f.write(f"{radii_valid[i]:.6f},{twist[i]:.6f}\n")

def save_rope_boundary(region_name, t_idx, radii, bphi_mean, n_per_bin):
    valid = n_per_bin > 0
    if not np.any(valid):
        return None
    radii_valid = radii[valid]
    bphi_valid = bphi_mean[valid]
    idx_bphi_max = np.argmax(np.abs(bphi_valid))
    r_bphi_max = radii_valid[idx_bphi_max]
    bphi_max = bphi_valid[idx_bphi_max]
    threshold = 0.1 * bphi_max
    idx_edge = np.where(np.abs(bphi_valid[idx_bphi_max:]) < threshold)[0]
    if len(idx_edge) > 0:
        r_boundary = radii_valid[idx_bphi_max + idx_edge[0]]
    else:
        r_boundary = radii_valid[-1]
    region_dir = os.path.join(OUTPUT_BASE, region_name)
    os.makedirs(os.path.join(region_dir, 'boundary'), exist_ok=True)
    boundary_file = os.path.join(region_dir, 'boundary', f'rope_boundary_t{t_idx:04d}.txt')
    with open(boundary_file, 'w') as f:
        f.write(f"r_Bphi_max,{r_bphi_max:.6f}\n")
        f.write(f"Bphi_max,{bphi_max:.6f}\n")
        f.write(f"r_boundary,{r_boundary:.6f}\n")
    return r_boundary

def save_axes(region_name, t_idx, time_val, center, axes, dynamic_center_used, center_shift):
    x_axis, y_axis, z_axis = axes
    region_dir = os.path.join(OUTPUT_BASE, region_name)
    os.makedirs(os.path.join(region_dir, 'axes'), exist_ok=True)
    axes_data = {
        "time_index": t_idx,
        "time_value": time_val,
        "dynamic_center_used": dynamic_center_used,
        "center_shift": float(center_shift),
        "center": [float(center[0]), float(center[1]), float(center[2])],
        "x_axis": [float(x_axis[0]), float(x_axis[1]), float(x_axis[2])],
        "y_axis": [float(y_axis[0]), float(y_axis[1]), float(y_axis[2])],
        "z_axis": [float(z_axis[0]), float(z_axis[1]), float(z_axis[2])]
    }
    axes_file = os.path.join(region_dir, 'axes', f'axes_t{t_idx:04d}.json')
    with open(axes_file, 'w') as f:
        json.dump(axes_data, f, indent=2)

