    axes[0].legend()
    axes[0].grid(True, alpha=0.3)

    axes[1].set_title('Shielding Parameter g')
    axes[1].set_xlabel('Time')
    axes[1].set_ylabel('g')
    axes[1].legend()
    axes[1].grid(True, alpha=0.3)

    axes[2].set_title('Fit Quality (NRMSE)')
    axes[2].set_xlabel('Time')
    axes[2].set_ylabel('NRMSE')
    axes[2].legend()
    axes[2].grid(True, alpha=0.3)

    plt.tight_layout()
    plt.savefig(DATA_DIR / 'exponential_evolution.png', dpi=150)
