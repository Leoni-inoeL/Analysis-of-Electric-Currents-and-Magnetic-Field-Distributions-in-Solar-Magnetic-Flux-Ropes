import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from pathlib import Path


DATA_DIR = Path(r"")  # path to the fit results file
df = pd.read_csv(DATA_DIR / "all_fit_results.csv")  # the fit results file

df['time_num'] = df['time'].astype(float)


def analyze_model_performance(df_):

    models = ['Gold-Hoyle', 'Lundquist', 'Exponential', 'Step-like']
    results = {}

    for model_ in models:
        model_df = df_[df_['model'] == model_]

        foot = model_df[model_df['region'] == 'footpoint']
        apex = model_df[model_df['region'] == 'apex']

        results[model_] = {
            'footpoint': {
                'mean_NRMSE': foot['NRMSE'].mean(),
                'std_NRMSE': foot['NRMSE'].std(),
                'mean_AIC': foot['AIC'].mean(),
                'n_fits': len(foot)
            },
            'apex': {
                'mean_NRMSE': apex['NRMSE'].mean(),
                'std_NRMSE': apex['NRMSE'].std(),
                'mean_AIC': apex['AIC'].mean(),
                'n_fits': len(apex)
            }
        }

    return results


def get_best_model_per_timestep(df_):

    best_models_ = []

    for region_ in ['footpoint', 'apex']:
        region_df = df_[df_['region'] == region_]

        for time in region_df['time_num'].unique():
            time_df = region_df[region_df['time_num'] == time]

            if len(time_df) > 0:
                best = time_df.loc[time_df['AIC'].idxmin()]
                best_models_.append({
                    'time': time,
                    'region': region_,
                    'best_model': best['model'],
                    'NRMSE': best['NRMSE'],
                    'AIC': best['AIC']
                })

    return pd.DataFrame(best_models_)


def plot_model_comparison(df_):
    fig, axes = plt.subplots(2, 2, figsize=(14, 10))

    models = ['Gold-Hoyle', 'Lundquist', 'Exponential', 'Step-like']
    colors = {'Gold-Hoyle': 'blue', 'Lundquist': 'red',
              'Exponential': 'green', 'Step-like': 'orange'}

    for region_idx, region_ in enumerate(['footpoint', 'apex']):
        row = 0 if region_idx == 0 else 1

        for model_ in models:
            model_df = df_[(df_['region'] == region_) & (df_['model'] == model_)]
            if len(model_df) > 0:
                axes[row, 0].plot(model_df['time_num'], model_df['NRMSE'],
                                  'o-', color=colors[model], label=model_, markersize=3)
                axes[row, 1].plot(model_df['time_num'], model_df['AIC'],
                                  'o-', color=colors[model], label=model_, markersize=3)

        axes[row, 0].set_title(f'{region_}: NRMSE Evolution')
        axes[row, 0].set_xlabel('Time')
        axes[row, 0].set_ylabel('NRMSE')
        axes[row, 0].legend()
        axes[row, 0].grid(True, alpha=0.3)

        axes[row, 1].set_title(f'{region_}: AIC Evolution')
        axes[row, 1].set_xlabel('Time')
        axes[row, 1].set_ylabel('AIC')
        axes[row, 1].legend()
        axes[row, 1].grid(True, alpha=0.3)

    plt.tight_layout()
    plt.savefig(DATA_DIR / 'model_comparison.png', dpi=150)
    plt.close()


def plot_gold_hoyle_parameters(df_):

    fig, axes = plt.subplots(1, 3, figsize=(15, 5))

    for region_ in ['footpoint', 'apex']:
        gh_df = df_[(df_['region'] == region_) & (df_['model'] == 'Gold-Hoyle')]

        if len(gh_df) > 0:
            # q param
            axes[0].plot(gh_df['time_num'], gh_df['q'], 'o-', label=region_, markersize=3)

            # NRMSE
            axes[1].plot(gh_df['time_num'], gh_df['NRMSE'], 'o-', label=region_, markersize=3)

            # AIC
            axes[2].plot(gh_df['time_num'], gh_df['AIC'], 'o-', label=region_, markersize=3)

    axes[0].set_title('Twist Parameter q')
    axes[0].set_xlabel('Time')
    axes[0].set_ylabel('q')
    axes[0].legend()
    axes[0].grid(True, alpha=0.3)

    axes[1].set_title('Fit Quality (NRMSE)')
    axes[1].set_xlabel('Time')
    axes[1].set_ylabel('NRMSE')
    axes[1].legend()
    axes[1].grid(True, alpha=0.3)

    axes[2].set_title('Akaike Information Criterion')
    axes[2].set_xlabel('Time')
    axes[2].set_ylabel('AIC')
    axes[2].legend()
    axes[2].grid(True, alpha=0.3)

    plt.tight_layout()
    plt.savefig(DATA_DIR / 'gold_hoyle_evolution.png', dpi=150)
    plt.close()


